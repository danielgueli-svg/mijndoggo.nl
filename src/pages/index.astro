---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import BreedClicker from "../components/BreedClicker.astro";
import TipCard from "../components/TipCard.astro";
import { loadBreeds } from "../lib/breeds";
import { unsplashSrc } from "../lib/images";
import { getCollection } from "astro:content";
import { site } from "../data/site";

const breeds = await loadBreeds();
const tips = (await getCollection("tips"))
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured))
  .slice(0, 3);
---

<BaseLayout>
  <Hero />
  <BreedClicker
    breeds={breeds}
    intro="Geen saaie encyclopedie. Gewoon een vrolijke klikplaat: tik een ras aan en duik in de knuffelzone."
  />

  <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
    <div class="flex items-end justify-between gap-4">
      <div>
        <p class="text-xs font-extrabold uppercase tracking-widest text-sky-deep">Tips & trucs</p>
        <h2 class="mt-1 font-display text-3xl font-semibold sm:text-4xl">Even bijleren, zonder saai te worden</h2>
      </div>
      <a href="/tips" class="hidden rounded-full bg-white px-4 py-2 text-sm font-extrabold shadow-pop ring-2 ring-ink/10 hover:bg-sun sm:inline-flex">
        Alle tips
      </a>
    </div>
    <div class="mt-6 grid gap-4 md:grid-cols-3">
      {
        tips.map((tip) => (
          <TipCard
            href={`/tips/${tip.id}`}
            title={tip.data.title}
            description={tip.data.description}
            category={tip.data.category}
            minutes={tip.data.minutes}
            image={unsplashSrc(tip.data.heroImage, 800, 450)}
            imageAlt={tip.data.heroImageAlt}
          />
        ))
      }
    </div>
    <a href="/tips" class="mt-6 inline-flex rounded-full bg-white px-4 py-2 text-sm font-extrabold shadow-pop ring-2 ring-ink/10 hover:bg-sun sm:hidden">
      Alle tips
    </a>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
    <div class="grid gap-6 overflow-hidden rounded-[2rem] bg-sky p-6 text-ink shadow-pop-lg ring-2 ring-ink/10 sm:p-10 md:grid-cols-[1.2fr_0.8fr]">
      <div>
        <h2 class="font-display text-3xl font-semibold sm:text-4xl">Open source, net als een park: voor iedereen.</h2>
        <p class="mt-3 max-w-xl text-base font-semibold leading-relaxed">
          {site.name} is MIT. Rassen voeg je toe via een datafile, tips via Markdown.
          Perfect voor een Nederlandse schrijfbot die later de teksten oppoetst.
        </p>
        <a href="/over" class="mt-5 inline-flex rounded-full bg-ink px-5 py-3 text-sm font-extrabold text-cream shadow-pop">
          Hoe het in elkaar zit
        </a>
      </div>
      <p class="self-center rounded-[1.4rem] bg-white/80 p-5 text-sm font-bold leading-relaxed">
        Geen accounts in v1. Geen webshop. Wel een hoop staarten, een ras-klikker, en een
        plekje voor jóuw hond — lokaal op je eigen apparaat.
      </p>
    </div>
  </section>
</BaseLayout>
