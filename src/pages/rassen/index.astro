---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BreedClicker from "../../components/BreedClicker.astro";
import { loadBreeds } from "../../lib/breeds";

const breeds = await loadBreeds();
---

<BaseLayout
  title="Rassen"
  description="Overzicht van hondrassen op MijnDoggo. Klik een ras en lees de vibe — plus een plekje voor honden van eigenaren."
>
  <div class="mx-auto max-w-6xl px-4 pb-2 pt-10 sm:px-6">
    <p class="text-xs font-extrabold uppercase tracking-widest text-coral">Ras-klikker</p>
    <h1 class="mt-2 font-display text-4xl font-semibold sm:text-5xl">Alle rassen in één vrolijke grid</h1>
    <p class="mt-3 max-w-2xl text-lg text-muted">
      Van labrador tot stabij. Filter op formaat, zoek op naam, en tik door naar het verhaal.
    </p>
  </div>
  <BreedClicker
    breeds={breeds}
    heading="Kies je crush"
    intro="Meer rassen? Drop een Markdown-bestand in content/breeds/. Echt, zo plat is het."
  />
</BaseLayout>
