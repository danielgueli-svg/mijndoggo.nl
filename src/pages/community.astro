---
import BaseLayout from "../layouts/BaseLayout.astro";
import CommunityBoard from "../components/CommunityBoard.tsx";
import SignupForm from "../components/SignupForm.tsx";
import { loadBreeds } from "../lib/breeds";
import { toCatalogBreed } from "../lib/serialize-breeds";

const catalog = (await loadBreeds()).map(toCatalogBreed);
---

<BaseLayout
  title="Leden"
  description="Zoek baasjes op woonplaats, zie wie er in jouw stad zit, en vind wandelplekken — altijd inclusief strand en bos."
>
  <div class="mx-auto max-w-6xl px-4 pb-2 pt-10 sm:px-6">
    <p class="text-xs font-extrabold uppercase tracking-widest text-coral">Leden</p>
    <h1 class="mt-2 font-display text-4xl font-semibold sm:text-5xl">
      Baasjes bij jou in de buurt
    </h1>
    <p class="mt-3 max-w-2xl text-lg text-muted">
      Zoek of tik een woonplaats. De lijst toont steden met de meeste baasjes eerst
      (Amsterdam · 3 leden). Daarna zie je iedereen daar — én uitlaatplekken in de buurt,
      plus altijd een strandwandeling en een boswandeling.
    </p>
  </div>

  <div class="mx-auto max-w-6xl px-4 py-6 sm:px-6">
    <CommunityBoard client:load />
  </div>

  <div class="mx-auto max-w-3xl px-4 pb-10 sm:px-6">
    <SignupForm client:load catalog={catalog} />
  </div>
</BaseLayout>
