---
import { nav, site } from "../data/site";
import Logo from "./Logo.astro";
---

<footer class="mt-16 border-t-4 border-ink/10 bg-ink text-cream">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:px-6 md:grid-cols-3">
    <div>
      <div class="flex items-center gap-2">
        <Logo class="h-16 w-16" loading="lazy" />
        <p class="font-display text-2xl font-semibold">{site.name}</p>
      </div>
      <p class="mt-3 max-w-sm text-sm leading-relaxed text-cream/80">
        Gemaakt met liefde, tennisballen en een beetje zand in de auto — open source,
        en helemaal in het Nederlands.
      </p>
    </div>
    <div>
      <p class="text-xs font-extrabold uppercase tracking-widest text-sun">Navigeren</p>
      <ul class="mt-3 space-y-2">
        {
          nav.map((item) => (
            <li>
              <a class="font-bold hover:text-sun" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <p class="text-xs font-extrabold uppercase tracking-widest text-sun">Open source</p>
      <p class="mt-3 text-sm leading-relaxed text-cream/80">
        MIT-licentie. Foto’s van Unsplash — zie
        <a class="font-bold text-sun underline decoration-2 underline-offset-2" href="/over#credits">
          credits
        </a>.
      </p>
      <p class="mt-4 text-sm text-cream/70">© {new Date().getFullYear()} {site.name}</p>
    </div>
  </div>
</footer>
