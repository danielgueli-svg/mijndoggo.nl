---
import { nav, site } from "../data/site";
import Logo from "./Logo.astro";

const isHome = Astro.url.pathname === "/";
---

<footer class="mt-16 border-t-4 border-ink/10 bg-ink text-cream">
  <div class:list={["mx-auto max-w-6xl px-4 py-12 sm:px-6", isHome ? "grid gap-8 md:grid-cols-2" : "grid gap-8 md:grid-cols-3"]}>
    <div>
      <div class="flex items-center gap-2">
        <Logo class="h-16 w-16" loading="lazy" />
        <p class="font-display text-2xl font-semibold">{site.name}</p>
      </div>
      {!isHome && (
        <p class="mt-3 max-w-sm text-sm leading-relaxed text-cream/80">
          Hondenmensen ontmoeten, tips delen, en een wandeling plannen — helemaal in het
          Nederlands.
        </p>
      )}
    </div>
    <div>
      <p class="text-xs font-extrabold uppercase tracking-widest text-sun">Navigeren</p>
      <ul class="mt-3 space-y-2">
        {
          nav.map((item) => (
            <li>
              <a class="font-bold hover:text-sun" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    {!isHome && (
      <div>
        <p class="text-xs font-extrabold uppercase tracking-widest text-sun">Foto’s</p>
        <p class="mt-3 text-sm leading-relaxed text-cream/80">
          Foto’s van Unsplash — zie
          <a class="font-bold text-sun underline decoration-2 underline-offset-2" href="/over#credits">
            credits
          </a>.
        </p>
      </div>
    )}
  </div>
  <p class="mx-auto max-w-6xl px-4 pb-10 text-sm text-cream/70 sm:px-6">
    © {new Date().getFullYear()} {site.name}
  </p>
</footer>
