---
import { energyLabels, sizeLabels, type Breed } from "../lib/breeds";
import { breedImageSrc } from "../lib/images";

type Props = { breed: Breed };

const { breed } = Astro.props;
---

<a
  href={`/rassen/${breed.slug}`}
  data-breed-card
  data-name={`${breed.name} ${breed.shortName}`.toLowerCase()}
  data-size={breed.size}
  class="group flex flex-col overflow-hidden rounded-[1.6rem] bg-white shadow-pop ring-2 ring-ink/10 transition hover:-translate-y-1 hover:ring-coral"
>
  <div class="relative aspect-[4/3] overflow-hidden bg-foam">
    <img
      src={breedImageSrc(breed.image, 640, 480)}
      alt={breed.image.alt}
      width="640"
      height="480"
      class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
      loading="lazy"
    />
    <span class="absolute left-3 top-3 rounded-full bg-sun px-2.5 py-1 text-[11px] font-extrabold uppercase tracking-wide text-ink">
      {sizeLabels[breed.size]}
    </span>
  </div>
  <div class="flex flex-1 flex-col gap-2 p-4">
    <h3 class="font-display text-xl font-semibold leading-tight text-ink">{breed.name}</h3>
    <p class="text-sm leading-snug text-muted">{breed.tagline}</p>
    <p class="mt-auto pt-2 text-xs font-extrabold uppercase tracking-widest text-sky-deep">
      {energyLabels[breed.energy]} →
    </p>
  </div>
</a>
