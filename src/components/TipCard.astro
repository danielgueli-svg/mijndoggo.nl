---
type Props = {
  href: string;
  title: string;
  description: string;
  category: string;
  minutes: number;
  image: string;
  imageAlt: string;
};

const { href, title, description, category, minutes, image, imageAlt } = Astro.props;

const categoryLabels: Record<string, string> = {
  wassen: "Wassen",
  wandelen: "Wandelen",
  plekken: "Plekken",
  voeding: "Voeding",
  verzorging: "Verzorging",
  overig: "Overig",
};
---

<a
  href={href}
  class="group flex flex-col overflow-hidden rounded-[1.6rem] bg-white shadow-pop ring-2 ring-ink/10 transition hover:-translate-y-1 hover:ring-sky"
>
  <div class="relative aspect-[16/9] overflow-hidden bg-foam">
    <img
      src={image}
      alt={imageAlt}
      width="800"
      height="450"
      class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
      loading="lazy"
    />
    <span class="absolute left-3 top-3 rounded-full bg-sky px-2.5 py-1 text-[11px] font-extrabold uppercase tracking-wide text-ink">
      {categoryLabels[category] ?? category}
    </span>
  </div>
  <div class="flex flex-1 flex-col gap-2 p-4">
    <h3 class="font-display text-xl font-semibold leading-tight">{title}</h3>
    <p class="text-sm leading-snug text-muted">{description}</p>
    <p class="mt-auto pt-2 text-xs font-extrabold uppercase tracking-widest text-coral">
      {minutes} min lezen →
    </p>
  </div>
</a>
