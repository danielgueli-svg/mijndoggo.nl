---
interface Props {
  class?: string;
  loading?: "eager" | "lazy";
}

const className = Astro.props.class ?? "h-11 w-11";
const loading = Astro.props.loading ?? "eager";
---

<img
  src="/logo-doghead.png"
  alt="MijnDoggo"
  width="512"
  height="512"
  class:list={["object-contain", className]}
  loading={loading}
  decoding="async"
/>
