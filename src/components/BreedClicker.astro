---
import type { Breed, BreedSize } from "../lib/breeds";
import BreedCard from "./BreedCard.astro";

type Props = {
  breeds: Breed[];
  heading?: string;
  intro?: string;
};

const { breeds, heading = "Kies een ras — en leer hoe het écht bij jullie past", intro } = Astro.props;

const sizes: { id: "alle" | BreedSize; label: string }[] = [
  { id: "alle", label: "Alle" },
  { id: "klein", label: "Klein" },
  { id: "middel", label: "Middel" },
  { id: "groot", label: "Groot" },
];
---

<section id="rassen" class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-xs font-extrabold uppercase tracking-widest text-coral">Ras-klikker</p>
      <h2 class="mt-1 font-display text-3xl font-semibold sm:text-4xl">{heading}</h2>
      {
        intro && (
          <p class="mt-2 max-w-2xl text-muted">{intro}</p>
        )
      }
    </div>
    <p class="text-sm font-bold text-muted">{breeds.length} rassen om te ontdekken</p>
  </div>

  <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center">
    <label class="relative block flex-1">
      <span class="sr-only">Zoek een ras</span>
      <input
        id="ras-zoek"
        type="search"
        placeholder="Zoek op rasnaam…"
        class="w-full rounded-full border-2 border-ink/15 bg-white px-5 py-3 text-sm font-bold shadow-pop outline-none placeholder:font-semibold placeholder:text-muted/70"
      />
    </label>
    <div class="flex flex-wrap gap-2" role="group" aria-label="Filter op formaat">
      {
        sizes.map((size, i) => (
          <button
            type="button"
            data-size-filter={size.id}
            class:list={[
              "size-filter rounded-full px-4 py-2 text-sm font-extrabold ring-2 ring-ink/10 transition",
              i === 0 ? "bg-ink text-cream" : "bg-white text-ink hover:bg-sun",
            ]}
          >
            {size.label}
          </button>
        ))
      }
    </div>
  </div>

  <p id="ras-leeg" class="mt-8 hidden rounded-[1.5rem] bg-white p-8 text-center font-bold text-muted ring-2 ring-ink/10">
    Geen ras gevonden. Misschien een tipfoutje — of een zeldzame mix die we nog mogen toevoegen?
  </p>

  <div id="ras-grid" class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
    {breeds.map((breed) => <BreedCard breed={breed} />)}
  </div>
</section>

<script>
  const search = document.getElementById("ras-zoek") as HTMLInputElement | null;
  const empty = document.getElementById("ras-leeg");
  const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-breed-card]"));
  const filters = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-size-filter]"));
  let size: string = "alle";

  function apply() {
    const q = (search?.value ?? "").trim().toLowerCase();
    let visible = 0;
    for (const card of cards) {
      const nameOk = !q || (card.dataset.name ?? "").includes(q);
      const sizeOk = size === "alle" || card.dataset.size === size;
      const show = nameOk && sizeOk;
      card.classList.toggle("hidden", !show);
      if (show) visible += 1;
    }
    empty?.classList.toggle("hidden", visible !== 0);
  }

  search?.addEventListener("input", apply);
  for (const btn of filters) {
    btn.addEventListener("click", () => {
      size = btn.dataset.sizeFilter ?? "alle";
      for (const other of filters) {
        const active = other === btn;
        other.classList.toggle("bg-ink", active);
        other.classList.toggle("text-cream", active);
        other.classList.toggle("bg-white", !active);
        other.classList.toggle("text-ink", !active);
      }
      apply();
    });
  }
</script>
