---
import { breedImageSrc } from "../lib/images";
import type { BreedImage } from "../data/photos";

type Props = {
  images: BreedImage[];
  breedName: string;
};

const { images, breedName } = Astro.props;
const photos = images.slice(0, 3);
---

<section class="breed-photo-compact mx-auto max-w-xl px-4 py-4 sm:px-6" aria-label={`Foto's van de ${breedName}`}>
  <p class="text-xs font-extrabold uppercase tracking-widest text-coral">Fotogalerij</p>
  <h2 class="mt-1 font-display text-2xl font-semibold">Even kijken. Even kwispelen.</h2>
  <div class="mt-4 grid grid-cols-3 gap-2">
    {
      photos.map((photo, index) => (
        <figure class="overflow-hidden rounded-2xl bg-white shadow-pop ring-2 ring-ink/10">
          <img
            src={breedImageSrc(photo, 420, 320)}
            alt={photo.alt}
            width="420"
            height="320"
            class="aspect-[4/3] w-full object-cover"
            loading={index === 0 ? "eager" : "lazy"}
          />
          <figcaption class="px-2 py-1.5 text-[10px] font-bold leading-tight text-muted">
            <a class="underline decoration-2 underline-offset-2" href={photo.unsplashUrl}>
              {photo.photographer}
            </a>
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>
